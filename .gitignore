# This repository uses a top-level whitelist. New folders at the workspace root
# are private by default: application years, company folders, trackers, exports,
# personal documents, recruiter CVs, scratch data, and signatures never become
# trackable merely because they were created under a new name.
/*
!/.gitignore
!/.claude/
!/CLAUDE.md
!/README.md
!/docs/
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md
!/identity.toml.example
!/scripts/
!/rules/
!/master/
!/automation/
!/start_claude.py
!/start_watcher.py
!/.github/

# Claude Code machine-local settings
/.claude/settings.local.json

# Per-person fact sources and generated rule context
/rules/00-canonical-profile.md
/rules/_digest.md
/rules/slices/_facts*.md
/rules/stale_patterns.txt

# Watcher secrets, preferences, learned state, runtime, and generated sandbox config
/automation/.env
/automation/.venv/
/automation/state/
/automation/logs/
/automation/profile_kb.md
/automation/decisions.jsonl
/automation/sources.toml
/automation/build_settings.json

# Coverage output. CI reports from a fresh run; a stale local file only ever
# disagrees with it.
/automation/.coverage
/automation/htmlcov/
/automation/coverage.xml

# Personal source and rendered documents kept under the generic master tree
/master/*.docx
/master/LaTeX/CV_*
/master/LaTeX/Cover_Letter_*
/master/LaTeX/images/photo.*
/master/LaTeX/images/signature.*

# proprietary fonts kept local only
/master/LaTeX/fonts/HelveticaNeue-*

# Generated Python/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
