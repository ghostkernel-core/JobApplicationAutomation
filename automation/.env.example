# Copy to automation/.env and fill in. That file is secrets only — never commit
# it, and never move these values into config.toml or sources.toml.
#
# TELEGRAM_BOT_TOKEN
#   Talk to @BotFather in Telegram: /newbot, pick a name and a username, and it
#   replies with a token that looks like 8123456789:AAH....
#
# TELEGRAM_CHAT_ID
#   Send your new bot any message, then open
#     https://api.telegram.org/bot<TOKEN>/getUpdates
#   and read result[0].message.chat.id. For a private chat it is your own user
#   id (a positive integer); for a group it is negative.
#   Only this chat can drive the watcher — every handler is filtered on it.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional: numeric knob overrides ----------------------------------------
# Every numeric setting in config.toml can be overridden here, as
# WATCHER_<SECTION>_<KEY>. An env value wins over the file; a real shell export
# wins over both. Leave a line out (or blank) to keep the config.toml value —
# a malformed value is warned about in the log and ignored, not fatal.
#
# Prefer config.toml for anything permanent: the file is tracked and each value
# sits next to the comment explaining why it is that value. These are for
# tuning a running deployment without editing it.
#
# [poll]
#   WATCHER_POLL_INTERVAL_MINUTES         30
#   WATCHER_POLL_MAX_AGE_DAYS             14
#   WATCHER_POLL_TIMEOUT_SECONDS          30
#   WATCHER_POLL_FAILURES_BEFORE_DISABLE  3
#   WATCHER_POLL_RETRY_AFTER_MINUTES      60   -> 0 disables auto-recovery
# [match]
#   WATCHER_MATCH_BATCH_SIZE              8
#   WATCHER_MATCH_NOTIFY_THRESHOLD        60   -> instant Telegram ping
#   WATCHER_MATCH_DIGEST_THRESHOLD        40   -> evening digest line
#   WATCHER_MATCH_DESCRIPTION_CHARS       4000
#   WATCHER_MATCH_TIMEOUT_SECONDS         180
# [notify]
#   WATCHER_NOTIFY_DIGEST_HOUR            19
#   WATCHER_NOTIFY_HEARTBEAT_HOUR         9
#   WATCHER_NOTIFY_SNOOZE_DAYS            7
# [build]
#   WATCHER_BUILD_TIMEOUT_MINUTES         45
#   WATCHER_BUILD_DUPLICATE_TITLE_RATIO   0.8
#   WATCHER_BUILD_DUPLICATE_LOOKBACK_DAYS 365
# [kb]
#   WATCHER_KB_WEEKDAY                    6    (0 = Monday)
#   WATCHER_KB_HOUR                       18
#   WATCHER_KB_MIN_DECISIONS              5
#   WATCHER_KB_LOOKBACK                   60
#   WATCHER_KB_TIMEOUT_SECONDS            180
#
# Not overridable on purpose — these change *what* runs, not how hard, so they
# belong in the tracked file: [build] enabled, [kb] enabled, every model name,
# and claude_bin.
