# Copy to automation/.env and fill in. That file is secrets only — never commit
# it, and never move these values into config.toml or sources.toml.
#
# TELEGRAM_BOT_TOKEN
#   Talk to @BotFather in Telegram: /newbot, pick a name and a username, and it
#   replies with a token that looks like 8123456789:AAH....
#
# TELEGRAM_CHAT_ID
#   Send your new bot any message, then open
#     https://api.telegram.org/bot<TOKEN>/getUpdates
#   and read result[0].message.chat.id. For a private chat it is your own user
#   id (a positive integer); for a group it is negative.
#   Only this chat can drive the watcher — every handler is filtered on it.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
